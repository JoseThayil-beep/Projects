# ── get_similarity() function (from Lab task 6A) ───────────────────────────────
get_similarity <- function(headline1, headline2) {
words1 <- headline1 %>% str_squish() %>% str_split(" ") %>% unlist()
words2 <- headline2 %>% str_squish() %>% str_split(" ") %>% unlist()
common <- intersect(words1, words2)
all    <- union(words1, words2)
similarity <- length(common) / length(all) * 100
return(similarity)
}
# ── Q6: Similarity between rows 118 and 37 ────────────────────────────────────
sim_score <- get_similarity(headlines_data$headline[118], headlines_data$headline[37])
round(sim_score, 1)
