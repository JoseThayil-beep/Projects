library(tidyverse)
library(tidyverse)
get_similarity <- function(headline1, headline2) {
words1 <- headline1 %>% str_squish() %>% str_split(" ") %>% unlist()
words2 <- headline2 %>% str_squish() %>% str_split(" ") %>% unlist()
same_words <- intersect(words1, words2)
all_words <- union(words1, words2)
similarity <- length(same_words) / length(all_words) * 100
return(similarity)
}
get_similarity(headlines_data$headline[44], headlines_data$headline[43])
compare_headlines <- tibble(headline1 = headlines_data$headline[1:59], headline2 = headlines_data$headline[60:118])
similarity_data <- compare_headlines %>%
rowwise() %>%
mutate(similarity_score = get_similarity(headline1, headline2))
similarity_data$similarity_score[15]
similarity_data$similarity_score %>% max()
similarity_data$similarity_score %>% mean()
