library(lubridate)
logged_data %>%
mutate(timestamp = mdy_hms(timestamp),
day_of_week = wday(timestamp, label = TRUE))
logged_data %>%
mutate(timestamp = mdy_hms(timestamp),
day_of_week = wday(timestamp, label = TRUE))
logged_data %>%
mutate(timestamp = mdy_hms(timestamp),
day_of_week = wday(timestamp, label = TRUE)) %>%
group_by(day_type) %>%
summarise(mean_proportions = mean(proportion, na.rm = TRUE)) %>%
arrange()
cleaned_data3 <- logged_data %>%
mutate(timestamp   = mdy_hms(timestamp),
day_of_week = wday(timestamp, label = TRUE)) %>%
group_by(day_of_week) %>%
summarise(mean_proportions = mean(proportion, na.rm = TRUE)) %>%
arrange(day_of_week)
cleaned_data3
cleaned_data3 <- logged_data %>%
mutate(timestamp   = mdy_hms(timestamp),
day_of_week = wday(timestamp, label = TRUE)) %>%
group_by(day_of_week) %>%
summarise(mean_proportions = mean(proportion, na.rm = TRUE)) %>% arrange(day_of_week)
cleaned_data3
ggplot(cleaned_data3, aes(x = day_of_week, y = mean_proportions))
ggplot(cleaned_data3, aes(x = mean_proportions, y = day_of_week))
